# ---- LLM provider -----------------------------------------------------------
# stub      : deterministic offline mode (no key needed) - used by tests and demos
# anthropic : Claude via the Messages API (set ANTHROPIC_API_KEY)
# openai    : any OpenAI-compatible endpoint (set OPENAI_API_KEY, optionally OPENAI_BASE_URL)
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# Key pool (comma separated, optional "label:" prefix). When a key is rate-limited, out of
# quota or rejected, the next one is used automatically. Takes precedence over OPENAI_API_KEY.
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama / vLLM / LiteLLM / Azure gateway
LLM_MAX_TOKENS=8000              # output cap per call; raise it (e.g. 32000) for reasoning models
LLM_TEMPERATURE=0.1              # dropped automatically for models that do not accept it

# ---- cost control -----------------------------------------------------------
# Reasoning effort (low | medium | high) for code-producing agents (developer, test_engineer,
# defect_resolver) vs. every other agent. Ignored by models without reasoning.
LLM_EFFORT_CODE=high
LLM_EFFORT_DEFAULT=low
LLM_TOKEN_BUDGET_PER_FEATURE=0   # hard stop for one feature (input + output tokens); 0 = unlimited
# USD per 1M tokens, for the dashboard's cost estimate (leave empty to show tokens only)
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_CACHED_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# ---- platform ---------------------------------------------------------------
SDLC_DATA_DIR=./data
SDLC_WORKSPACE_ROOT=./workspaces
SDLC_GATES_CONFIG=./config/gates.yaml
SDLC_TOOL_TIMEOUT=180
SDLC_ENABLE_PIP_AUDIT=false        # needs network access to PyPI advisory data

# ---- observability (optional) ------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
